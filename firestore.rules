rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

     function existing() {
       return resource.data;
     }

     // Detects attempts to mutate boost fields client-side so that only the
     // trusted server (Firebase Admin, which bypasses rules) can grant a boost.
     function isBoostFieldChange() {
       let changed = request.resource.data.diff(resource.data).affectedKeys();
       return changed.hasAny(['boostActive', 'boostPlan', 'boostStartedAt', 'boostExpiresAt']);
     }

    // 1. Private User Collection (Strict PII isolation: email, real identity)
    // Only the account owner can read or write their private account doc.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) 
                    && isValidId(userId)
                    && incoming().uid == request.auth.uid;
       allow update: if isOwner(userId) 
                    && incoming().uid == existing().uid
                    && !isBoostFieldChange();
      allow delete: if isOwner(userId);

      // Likes received by this user: written by the member who liked them.
      match /likes_received/{likeId} {
        allow create: if isSignedIn()
                      && isValidId(likeId)
                      && incoming().fromUserId == request.auth.uid
                      && incoming().toUserId == userId;
        allow list, get: if isOwner(userId);
        allow update, delete: if false;
      }

      // Likes sent by this user: written by the member who sent the like.
      match /likes_sent/{likeId} {
        allow create: if isOwner(userId)
                      && isValidId(likeId)
                      && incoming().fromUserId == userId
                      && incoming().toUserId is string;
        allow list, get: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    // 2. Public Dating Profiles (Readable by signed in users, writable only by owner)
    match /profiles/{profileId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(profileId) 
                    && isValidId(profileId)
                    && incoming().uid == request.auth.uid;
      allow update: if isOwner(profileId) 
                    && incoming().uid == existing().uid
                    && !isBoostFieldChange();
      allow delete: if isOwner(profileId);
    }

    // 3. User Dating Preferences (Private to the user)
    match /preferences/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) 
                    && isValidId(userId)
                    && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) 
                    && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);
    }

    // 4. Photos Collection
    match /photos/{photoId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() 
                    && isValidId(photoId)
                    && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() 
                    && existing().userId == request.auth.uid 
                    && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() 
                    && existing().userId == request.auth.uid;
    }

    // 5. Verification Requests (Owner submits their own docs; admin-only moderation handled server-side)
    match /verification_requests/{verificationId} {
      allow create: if isSignedIn()
                    && isValidId(verificationId)
                    && incoming().userId == request.auth.uid
                    && incoming().status == 'pending';
      allow get, list: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // 6. Boost purchase history (admin/server-only writes; owner can read own history)
    match /boosts/{boostId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      // creation/update/deletion only happens via the trusted server (Admin SDK).
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 7. Boost payment intents (server-only; never written/read by clients directly)
    match /boost_payments/{paymentId} {
      allow read, write: if false;
    }
  }
}
