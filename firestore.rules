rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Private User Collection (Strict PII isolation: email, real identity)
    // Only the account owner can read or write their private account doc.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) 
                    && isValidId(userId)
                    && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) 
                    && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);
    }

    // 2. Public Dating Profiles (Readable by signed in users, writable only by owner)
    match /profiles/{profileId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(profileId) 
                    && isValidId(profileId)
                    && incoming().uid == request.auth.uid;
      allow update: if isOwner(profileId) 
                    && incoming().uid == existing().uid;
      allow delete: if isOwner(profileId);
    }

    // 3. User Dating Preferences (Private to the user)
    match /preferences/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) 
                    && isValidId(userId)
                    && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) 
                    && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);
    }

    // 4. Photos Collection
    match /photos/{photoId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() 
                    && isValidId(photoId)
                    && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() 
                    && existing().userId == request.auth.uid 
                    && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() 
                    && existing().userId == request.auth.uid;
    }
  }
}
